# SOC Copilot Workbench — backend environment variables
# Copy this file to .env and fill in values as needed.
# .env is gitignored and must never be committed.

# ── AI Investigation Assistant ────────────────────────────────────────────────
# AI provider to use for the investigation assistant.
# Options: mock (default — no API key needed), anthropic, openai
AI_PROVIDER=mock

# Anthropic API key — required only when AI_PROVIDER=anthropic
# Obtain from https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# OpenAI API key — required only when AI_PROVIDER=openai
OPENAI_API_KEY=

# Model override — defaults to claude-haiku-4-5-20251001 for Anthropic
# AI_MODEL=claude-haiku-4-5-20251001

# ── Storage ───────────────────────────────────────────────────────────────────
# Directory where uploaded evidence files are stored (relative to services/api/)
# Default: ./uploads  — change to an absolute path in production
# UPLOAD_DIR=./uploads

# ── Safety ────────────────────────────────────────────────────────────────────
# This is a DEFENSIVE SOC tool. Never connect production SIEM credentials
# in development mode. Do not upload live malware outside an isolated lab.
